* text=auto

# Tcl/PowerShell 源码保持可读文本，避免 CRLF 影响 tclsh 解析
*.tcl text eol=lf
*.md  text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf

